    "mqemitter-redis": "^7.1.0",
    "nestjs-i18n": "^10.5.1",
    "nestjs-pino": "^4.4.1",
    "nestjs-s3": "^3.0.1",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^9.11.0",
    "pino-abstract-transport": "^2.0.0",
    "pino-elasticsearch": "^8.1.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
