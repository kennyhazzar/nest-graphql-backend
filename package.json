    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "country-locale-map": "^1.9.9",
    "dayjs": "^1.11.18",
